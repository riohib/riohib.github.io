---
layout: default
---

<style>
  /* Updated style block for a more polished hover effect */
  .image-item {
    /* Add padding to prevent content from touching the edges on hover */
    padding: 10px;
    border-radius: 8px; /* Start with slightly rounded corners */
    transition: transform 0.3s ease, box-shadow 0.3s ease; /* Smoother 'ease' transition */
  }

  .image-item:hover {
    /* This now scales AND moves the box up by 5 pixels */
    transform: scale(1.05) translateY(-5px);

    /* A softer, more spread-out shadow for a polished "lifted" look */
    box-shadow: 0 8px 25px rgba(0,0,0,0.12);
  }
</style>

<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>

  <article>
    {% if page.profile %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1
      rounded' %}
          {% endif %}
          {% capture sizes %}(min-width: {{site.max_width}}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px)
      30vw, 95vw"{% endcapture %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
            cache_bust=true
          %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="clearfix">{{ content }}</div>

    <!-- Image Grid (ADDED by ME) -->

    <!-- ADD THIS LINE for the title -->
    <hr class="section-line" style="margin-bottom: 0.5rem;">
    <p style="margin-top: 0rem; font-weight: 400;">
      Research and Work Experience
    <p>
    <hr class="section-line" style="margin-top: -0.5rem; opacity: 0.7;">
    

    <!-- SCALING CONTAINER - Change the scale value here to resize entire section -->
    <div class="affiliations-scale-container" style="transform: scale(0.95); transform-origin: center;">
      <div class="image-grid" style="display: flex; flex-wrap: nowrap; justify-content: space-around;">

        <!-- New Image Item -->
        <div class="image-item" style="flex: 1 1 20%; text-align: center; margin: 10px;">
          <a href="https://deepmind.google/" target="_blank" rel="noopener noreferrer" style="color: inherit; text-decoration: none;">
            <img src="{{ 'assets/img/deepmind.svg' | trends }}" alt="New Image" style="margin-top: -2px; transform: scale(0.90); width: 100%;">
            <div class="image-description" style="text-align: center; line-height: 0.3; margin-top: 18px; font-size: 14px;">
              <p>Google DeepMind</p>
              <p>Fall 2025</p>
            </div>
          </a>
        </div>
        
      <!-- New Image Item -->
      <div class="image-item" style="flex: 1 1 20%; text-align: center; margin: 10px;">
        <a href="https://cohere.com/" target="_blank" rel="noopener noreferrer" style="color: inherit; text-decoration: none;">
          <img src="{{ 'assets/img/cohere.png' | cohere }}" alt="Cohere" style="margin-top: -13px; transform: scale(1); width: 100%;">
          <div class="image-description" style="text-align: center; line-height: 0.3; margin-top: 9px; font-size: 14px;">
            <p>Cohere</p>
            <p>Fall 2024</p>
          </div>
        </a>
      </div>

      <!-- New Image Item -->
      <div class="image-item" style="flex: 1 1 20%; text-align: center; margin: 10px;">
        <a href="https://www.dolby.com/" target="_blank" rel="noopener noreferrer" style="color: inherit; text-decoration: none;">
          <img src="{{ 'assets/img/dolby.png' | dolby }}" alt="Dolby Labs" style="margin-top: -14px; transform: scale(0.80); width: 100%;">
          <div class="image-description" style="text-align: center; line-height: 0.3; margin-top: 0px; font-size: 14px;">
            <p>Dolby Labs</p>
            <p>Summer 2024</p>
          </div>
        </a>
      </div>

      <!-- New Image Item -->
      <div class="image-item" style="flex: 1 1 20%; text-align: center; margin: 10px;">
        <a href="https://ai.meta.com/research/" target="_blank" rel="noopener noreferrer" style="color: inherit; text-decoration: none;">
          <img src="{{ 'assets/img/meta_ai.png' | meta_ai }}" alt="FAIR at Meta AI" style="margin-top: -10px; transform: scale(0.9); width: 100%;">
          <div class="image-description" style="text-align: center; line-height: 0.3; margin-top: 12px; font-size: 14px;">
            <p>FAIR at Meta AI</p>
            <p>Summer 2022</p>
          </div>
        </a>
      </div>

      <!-- New Image Item -->
      <div class="image-item" style="flex: 1 1 20%; text-align: center; margin: 10px;">
        <a href="https://www.gatech.edu/" target="_blank" rel="noopener noreferrer" style="color: inherit; text-decoration: none;">
          <img src="{{ 'assets/img/gt.png' | gatech }}" alt="Georgia Tech" style="margin-top: -20px; transform: scale(0.70); width: 100%;">
          <div class="image-description" style="text-align: center; line-height: 0.3; margin-top: 0px; font-size: 14px;">
            <p>Georgia Tech</p>
            <p>Aug 2019 - Present</p>
          </div>
        </a>
      </div>

      </div>
    </div>

    <!-- Below line -->
    <hr class="section-line">

    <!-- News -->
    {% if page.news and site.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if site.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">selected publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter.enabled and site.footer_fixed %}
      {% include scripts/newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>