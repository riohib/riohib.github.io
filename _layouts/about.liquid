---
layout: default
---

<style>
  /* --- CONTROL PARAMETERS --- */
  /* Adjust these values to scale logos and boxes */
  :root {
    --logo-container-width: 95px;   /* Width of logo container (adjust to make logo column wider/narrower) */
    --logo-container-height: 40px;  /* Height of logo container (adjust to make rows taller/shorter) */
    --time-column-width: 120px;     /* Width of time column (adjust gap to experience detail) */
    --logo-image-zoom: 0.75;         /* Global zoom factor for all logos (>1.0 crops whitespace, <1.0 adds space) */
    --box-scale: 0.0;               /* Scale factor for padding/box size (1.0 = default, 1.2 = 20% larger padding) */
    --section-header-spacing: 1.0rem; /* Space below section headers (reduce to bring content closer) */
    --entry-border-opacity: 0.05;    /* Opacity of border between entries (0.0 = invisible, 1.0 = solid) */
    --entry-padding: 0.4rem;         /* Vertical padding between each entry (increase for more space) */
    --profile-image-scale: 0.8;      /* Scale factor for profile photo (1.0 = default, 0.8 = 20% smaller) */
    --about-to-experience-gap: -1.0rem; /* Gap between about section and experience section */
    --experience-to-education-gap: 1.5rem; /* Gap between experience section and education section */
    
    /* Individual logo scale adjustments (multiplied with global zoom) */
    --logo-scale-deepmind: 1.5;     /* Google DeepMind logo scale */
    --logo-scale-cohere: 1.2;       /* Cohere logo scale */
    --logo-scale-dolby: 0.95;        /* Dolby Labs logo scale */
    --logo-scale-meta: 1.4;         /* Meta AI logo scale */
    --logo-scale-gatech: 1.6;       /* Georgia Tech logo scale */
    --logo-scale-trends: 1.4;       /* TReNDS center logo scale */
    
    /* Individual logo position adjustments (negative=left/up, positive=right/down) */
    --logo-pos-deepmind-x: 3px;     /* DeepMind horizontal offset */
    --logo-pos-deepmind-y: -5px;     /* DeepMind vertical offset */
    --logo-pos-cohere-x: -3px;       /* Cohere horizontal offset */
    --logo-pos-cohere-y: -3px;       /* Cohere vertical offset */
    --logo-pos-dolby-x: -8px;        /* Dolby horizontal offset */
    --logo-pos-dolby-y: 0px;        /* Dolby vertical offset */
    --logo-pos-meta-x: -2px;         /* Meta AI horizontal offset */
    --logo-pos-meta-y: -4px;         /* Meta AI vertical offset */
    --logo-pos-gatech-x: 10px;       /* Georgia Tech horizontal offset */
    --logo-pos-gatech-y: -6px;       /* Georgia Tech vertical offset */
    --logo-pos-trends-x: 2px;       /* TReNDS center horizontal offset */
    --logo-pos-trends-y: -5px;       /* TReNDS center vertical offset */
  }

  /* --- Experience Section Container --- */
  .experience-list {
    margin: 2rem 0;
  }

  /* --- Individual Experience Item (Column-based Layout) --- */
  .experience-item {
    display: grid;
    grid-template-columns: var(--logo-container-width) var(--time-column-width) 1fr;
    align-items: start;
    gap: 1rem;
    padding: var(--entry-padding) 0;
    border-bottom: 1px solid rgba(0, 0, 0, var(--entry-border-opacity));
  }

  .experience-item:last-child {
    border-bottom: none;
  }

  /* --- Logo Column --- */
  .experience-logo {
    flex-shrink: 0;
    width: var(--logo-container-width);
    height: var(--logo-container-height);
    display: flex;
    align-items: center; /* Center image vertically */
    justify-content: center; /* Center image horizontally */
    overflow: visible; /* Allow shadow to show */
    padding: 0.5rem;
    border-radius: 8px;
    background-color: transparent;
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), 
                box-shadow 0.4s ease,
                background-color 0.4s ease;
    cursor: pointer;
  }

  .experience-logo:hover {
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.12),
                0 4px 8px rgba(0, 0, 0, 0.08);
    background-color: rgba(255, 255, 255, 0.6);
  }

  .experience-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center center; /* Center the image */
    transform: scale(var(--logo-image-zoom));
    filter: grayscale(15%) opacity(0.9);
    transition: filter 0.4s ease;
    border-radius: 6px;
  }

  .experience-logo:hover img {
    filter: grayscale(0%) opacity(1);
  }

  /* --- Individual Logo Scaling --- */
  .experience-logo img[alt*="DeepMind"] {
    transform: scale(calc(var(--logo-image-zoom) * var(--logo-scale-deepmind)));
  }

  .experience-logo img[alt*="Cohere"] {
    transform: scale(calc(var(--logo-image-zoom) * var(--logo-scale-cohere)));
  }

  .experience-logo img[alt*="Dolby"] {
    transform: scale(calc(var(--logo-image-zoom) * var(--logo-scale-dolby)));
  }

  .experience-logo img[alt*="Meta"] {
    transform: scale(calc(var(--logo-image-zoom) * var(--logo-scale-meta)));
  }

  .experience-logo img[alt*="Georgia"] {
    transform: scale(calc(var(--logo-image-zoom) * var(--logo-scale-gatech)));
  }

  .experience-logo img[alt*="TReNDS"] {
    transform: scale(calc(var(--logo-image-zoom) * var(--logo-scale-trends)));
  }

  /* --- Individual Logo Container Positioning --- */
  /* Base position transforms - these move the entire container */
  .experience-logo:has(img[alt*="DeepMind"]) {
    transform: translate(var(--logo-pos-deepmind-x), var(--logo-pos-deepmind-y));
  }

  .experience-logo:has(img[alt*="DeepMind"]):hover {
    transform: translate(var(--logo-pos-deepmind-x), calc(var(--logo-pos-deepmind-y) - 6px)) scale(1.08);
  }

  .experience-logo:has(img[alt*="Cohere"]) {
    transform: translate(var(--logo-pos-cohere-x), var(--logo-pos-cohere-y));
  }

  .experience-logo:has(img[alt*="Cohere"]):hover {
    transform: translate(var(--logo-pos-cohere-x), calc(var(--logo-pos-cohere-y) - 6px)) scale(1.08);
  }

  .experience-logo:has(img[alt*="Dolby"]) {
    transform: translate(var(--logo-pos-dolby-x), var(--logo-pos-dolby-y));
  }

  .experience-logo:has(img[alt*="Dolby"]):hover {
    transform: translate(var(--logo-pos-dolby-x), calc(var(--logo-pos-dolby-y) - 6px)) scale(1.08);
  }

  .experience-logo:has(img[alt*="Meta"]) {
    transform: translate(var(--logo-pos-meta-x), var(--logo-pos-meta-y));
  }

  .experience-logo:has(img[alt*="Meta"]):hover {
    transform: translate(var(--logo-pos-meta-x), calc(var(--logo-pos-meta-y) - 6px)) scale(1.08);
  }

  .experience-logo:has(img[alt*="Georgia"]) {
    transform: translate(var(--logo-pos-gatech-x), var(--logo-pos-gatech-y));
  }

  .experience-logo:has(img[alt*="Georgia"]):hover {
    transform: translate(var(--logo-pos-gatech-x), calc(var(--logo-pos-gatech-y) - 6px)) scale(1.08);
  }

  .experience-logo:has(img[alt*="TReNDS"]) {
    transform: translate(var(--logo-pos-trends-x), var(--logo-pos-trends-y));
  }

  .experience-logo:has(img[alt*="TReNDS"]):hover {
    transform: translate(var(--logo-pos-trends-x), calc(var(--logo-pos-trends-y) - 6px)) scale(1.08);
  }

  /* --- Role & Time Column --- */
  .experience-role-time {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .experience-role {
    font-size: 0.875rem;
    font-weight: var(--global-bold-font-weight, 500);
    color: var(--global-bold-text-color, #555);
    line-height: 1.2;
    margin: 0;
  }

  .experience-time {
    font-size: 0.8rem;
    color: var(--global-text-color, #666);
    opacity: 0.75;
    line-height: 1.2;
    margin: 0;
  }

  /* --- Summary Column --- */
  .experience-summary-container {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .experience-summary {
    font-size: 0.9rem;
    line-height: 1.3;
    color: var(--global-text-color, #555);
    margin: 0;
    opacity: 0.85;
    text-align: left;
  }

  .experience-summary-small {
    font-size: 0.8rem;
    opacity: 0.75;
  }

  /* --- Experience Content (wrapper for company and time) --- */
  .experience-content {
    display: contents; /* Makes children participate in parent grid */
  }

  .experience-header-row {
    display: contents; /* Makes children participate in parent grid */
  }

  /* --- Link Styling (only wraps logo now) --- */
  .experience-link {
    color: inherit;
    text-decoration: none;
    display: block;
  }

  .experience-link:hover {
    text-decoration: none;
  }

  /* --- Section Header --- */
  .experience-section-header {
    margin: var(--about-to-experience-gap) 0 var(--section-header-spacing) 0;
  }

  /* Education section header - separate gap control */
  .experience-section-header.education-header {
    margin-top: var(--experience-to-education-gap);
  }

  .experience-section-header h5 {
    margin: 0;
    font-weight: 400;
    font-size: 1rem;
    color: var(--global-text-color, #333);
  }

  /* --- Mobile Responsive Styles --- */
  @media (max-width: 768px) {
    .experience-item {
      grid-template-columns: var(--logo-container-width) 1fr;
      gap: 0.75rem;
      padding: 0.5rem 0;
    }

    .experience-link {
      grid-row: 1;
      grid-column: 1;
      display: block;
    }

    .experience-role-time {
      grid-row: 1;
      grid-column: 2;
    }

    .experience-role {
      font-size: 0.85rem;
    }

    .experience-time {
      font-size: 0.75rem;
    }

    .experience-summary-container {
      grid-row: 2;
      grid-column: 1 / -1;
      margin-top: 0.25rem;
    }

    /* Direct summary elements (experience section) - target summaries that are grid items */
    .experience-item > .experience-summary {
      grid-row: 2;
      grid-column: 1 / -1;
      margin-top: 0.25rem;
    }

    /* Override for summaries inside container (education section) */
    .experience-summary-container .experience-summary {
      grid-row: auto;
      grid-column: auto;
      margin-top: 0;
    }

    .experience-summary {
      font-size: 0.85rem;
    }
  }

  @media (max-width: 480px) {
    .experience-item {
      gap: 0.5rem;
    }
  }

  /* --- Profile Photo Scaling & Alignment --- */
  .profile {
    vertical-align: top;
    margin-top: 0;
  }

  .profile.float-right {
    margin-left: 0.15rem; /* Minimal margin to move text column boundary left */
  }

  .profile.float-left {
    margin-right: 0.15rem; /* Minimal margin to move text column boundary left */
  }

  .profile img {
    transform: scale(var(--profile-image-scale));
    transform-origin: top center;
    display: block;
  }

  /* --- Reduce gap between about section and experience section --- */
  .clearfix {
    margin-bottom: 0.5rem;
  }

  /* Constrain text column width when profile photo is present */
  article .clearfix {
    max-width: 100%; /* Makes text column narrower when photo is floated */
  }
</style>

<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
        {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>

  <article>
    {% if page.profile %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1
      rounded' %}
          {% endif %}
          {% capture sizes %}(min-width: {{site.max_width}}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px)
      30vw, 95vw"{% endcapture %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
            cache_bust=true
          %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="clearfix">{{ content }}</div>

    <!-- Experience Section -->
    <div class="experience-section-header">
      <h5>Research and Work Experience</h5>
    </div>
    
    <div class="experience-list">
      <!-- Google DeepMind - Research Scientist -->
      <div class="experience-item">
        <a href="https://deepmind.google/" target="_blank" rel="noopener noreferrer" class="experience-link">
          <div class="experience-logo">
            <img src="{{ 'assets/img/deepmind.svg' | trends }}" alt="Google DeepMind">
          </div>
        </a>
        <div class="experience-role-time">
          <p class="experience-role">Research Scientist</p>
          <p class="experience-time">July 2026 - Present</p>
        </div>
        <p class="experience-summary">Representation alignment, model behavior, and interpretability for AGI Readiness.</p>
      </div>

      <!-- Google DeepMind -->
      <div class="experience-item">
        <a href="https://deepmind.google/" target="_blank" rel="noopener noreferrer" class="experience-link">
          <div class="experience-logo">
            <img src="{{ 'assets/img/deepmind.svg' | trends }}" alt="Google DeepMind">
          </div>
        </a>
        <div class="experience-role-time">
          <p class="experience-role">Research Intern</p>
          <p class="experience-time">Spring 2026</p>
          <p class="experience-time">Fall 2025</p>
        </div>
        <p class="experience-summary">Diffusion model representation engineering and alignment. Focus on analysis, controllability, interpretability & safety.</p>
      </div>

      <!-- Cohere -->
      <div class="experience-item">
        <a href="https://cohere.com/" target="_blank" rel="noopener noreferrer" class="experience-link">
          <div class="experience-logo">
            <img src="{{ 'assets/img/cohere.png' | cohere }}" alt="Cohere">
          </div>
        </a>
        <div class="experience-role-time">
          <p class="experience-role">Research Intern</p>
          <p class="experience-time">Fall 2024</p>
        </div>
        <p class="experience-summary">Inference-time activation sparsity techniques for large language models (LLMs).</p>
      </div>

      <!-- Dolby Labs -->
      <div class="experience-item">
        <a href="https://www.dolby.com/" target="_blank" rel="noopener noreferrer" class="experience-link">
          <div class="experience-logo">
            <img src="{{ 'assets/img/dolby.png' | dolby }}" alt="Dolby Labs">
          </div>
        </a>
        <div class="experience-role-time">
          <p class="experience-role">Research Intern</p>
          <p class="experience-time">Summer 2024</p>
        </div>
        <p class="experience-summary">Efficient fine-tuning method for LLMs using probabilistic layer selection.</p>
      </div>

      <!-- Meta AI -->
      <div class="experience-item">
        <a href="https://ai.meta.com/research/fair/" target="_blank" rel="noopener noreferrer" class="experience-link">
          <div class="experience-logo">
            <img src="{{ 'assets/img/meta_ai.png' | meta_ai }}" alt="FAIR at Meta AI">
          </div>
        </a>
        <div class="experience-role-time">
          <p class="experience-role">Research Intern</p>
          <p class="experience-time">Summer 2022</p>
        </div>
        <p class="experience-summary">At Meta FAIR I worked on research on signal processing based techniques for sparse Deep Learning. My neural network sparsity library was integrated with the <a href="https://github.com/facebookresearch/fairscale">facebookresearch/fairscale</a> repo.</p>
      </div>

      <!-- TReNDS Center -->
      <div class="experience-item">
        <a href="https://trendscenter.org/" target="_blank" rel="noopener noreferrer" class="experience-link">
          <div class="experience-logo">
            <img src="{{ 'assets/img/trends.png' | trends }}" alt="TReNDS Center">
          </div>
        </a>
        <div class="experience-role-time">
          <p class="experience-role">GRA</p>
          <p class="experience-time">Fall 2019 - Present</p>
        </div>
        <p class="experience-summary">Graduate research assistant (GRA) with Dr. Vince Calhoun and Dr. Sergey Plis.</p>
      </div>

    </div>

    <!-- Education Section -->
    <div class="experience-section-header education-header">
      <h5>Education</h5>
    </div>
    
    <div class="experience-list">
      <!-- Georgia Tech PhD -->
      <div class="experience-item">
        <a href="https://www.gatech.edu/" target="_blank" rel="noopener noreferrer" class="experience-link">
          <div class="experience-logo">
            <img src="{{ 'assets/img/gt.png' | gatech }}" alt="Georgia Tech">
          </div>
        </a>
        <div class="experience-role-time">
          <p class="experience-role">Ph.D. in ECE</p>
          <p class="experience-time">Aug 2021 - May 2026</p>
        </div>
        <div class="experience-summary-container">
          <p class="experience-summary">Research in learning algorithms and sparse learning across domains.</p>
          <p class="experience-summary">Dissertation: Principled Sparsity for Efficient Deep Learning Across Computational Paradigms.</p>
          <p class="experience-summary experience-summary-small">CGPA 4.0/4.0</p>
        </div>
      </div>


      <!-- Georgia Tech Master's -->
      <div class="experience-item">
        <a href="https://www.gatech.edu/" target="_blank" rel="noopener noreferrer" class="experience-link">
          <div class="experience-logo">
            <img src="{{ 'assets/img/gt.png' | gatech }}" alt="Georgia Tech">
          </div>
        </a>
        <div class="experience-role-time">
          <p class="experience-role">Master's</p>
          <p class="experience-time">Aug 2019 - May 2021</p>
        </div>
        <div class="experience-summary-container">
          <p class="experience-summary">Research and thesis on Explicit Group Sparse Projection. <a href="https://repository.gatech.edu/entities/publication/84534827-bf15-4cdb-a753-ff621cc60d00">Master's Thesis</a>.</p>
          <p class="experience-summary experience-summary-small">CGPA 4.0/4.0</p>
        </div>
      </div>
    </div>

    <!-- Below line -->
    <hr class="section-line">

    <!-- News -->
    {% if page.news and site.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">news</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if site.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">selected publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter.enabled and site.footer_fixed %}
      {% include scripts/newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
